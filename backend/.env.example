# ─────────────────────────────────────────────────────────────────────────────
# GrowthOS Backend – Environment Configuration Example
# Copy this file to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Core ────────────────────────────────────────────────────────────────────
DEBUG=false
APP_NAME=GrowthOS

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (development default — works out of the box):
DATABASE_URL=sqlite+aiosqlite:///./growthos.db

# Supabase / PostgreSQL (Production & Cloud DB):
# Direct connection (Session mode, port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Transaction Pooler connection (PgBouncer mode, port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# ─── Redis (required for Celery background tasks) ────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT / Security ──────────────────────────────────────────────────────────
# ⚠️ Change this to a long random string in production!
JWT_SECRET=change-me-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── SMTP Email ──────────────────────────────────────────────────────────────
# Leave blank → runs in Simulation Mode (logs to DB only, no actual email sent)
# Fill in SMTP credentials to send real emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=GrowthOS
SMTP_USE_TLS=true

# ─── Gmail OAuth (Inbox / Send via Gmail) ────────────────────────────────────
# Create a project at https://console.cloud.google.com and enable the Gmail API
# Leave as defaults to run in simulation mode.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback

# Fernet key for encrypting stored OAuth tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_ENCRYPTION_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Obtain from https://dashboard.stripe.com/apikeys
# Leave blank to skip signature verification (webhook still processes events)
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── PayPal ──────────────────────────────────────────────────────────────────
# Obtain from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# ─── Frontend URL (CORS) ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174
